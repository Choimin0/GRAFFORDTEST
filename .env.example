# ────────────────────────────────────────────────────────────────────────────
# .env.example  —  실제 값은 Vercel 대시보드 > Settings > Environment Variables
#                  에서만 관리하세요. 이 파일은 값 없는 템플릿입니다.
# ────────────────────────────────────────────────────────────────────────────

# DB (Prisma Postgres / Neon)
POSTGRES_URL=
DATABASE_URL=

# 토큰 서명 키 (openssl rand -hex 32 으로 생성)
RESERVATION_CANCEL_TOKEN_SECRET=
BOOKING_TOKEN_SECRET=

# 어드민 로그인
ADMIN_ID=
ADMIN_PW=

# 허용 CORS Origin (어드민 API용, 예: https://your-project.vercel.app)
ALLOWED_ORIGIN=

# iCal
ICAL_IMPORT_DISABLED=false
ICAL_EXPORT_TOKEN=
ICAL_SYNC_SECRET=
ICAL_IMPORT_URLS_G1=
ICAL_IMPORT_URLS_G2=
ICAL_IMPORT_URLS_G3=
ICAL_IMPORT_URLS_G4=

# 포트원 v2
STORE_ID=
CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
NAVER_PAY_CHANNEL_KEY=

# 개인정보 암호화 키 (openssl rand -hex 32)
CRYPTO_KEY=

# 솔라피 (카카오 알림톡)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=
SOLAPI_FROM=
SOLAPI_TEMPLATE_RESERVE_COMPLETE=
SOLAPI_TEMPLATE_CANCEL_COMPLETE=
SOLAPI_TEMPLATE_CHECKIN_ALARM=
SOLAPI_PROPERTY_ADDRESS=

# GCP / BigQuery
GOOGLE_PROJECT_ID=
GEMINI_API_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_BIGQUERY_DATASET=
GOOGLE_BIGQUERY_TABLE=
GOOGLE_BIGQUERY_CANCEL_TABLE=
GOOGLE_PRIVATE_KEY=
